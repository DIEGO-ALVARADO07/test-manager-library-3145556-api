APP_NAME="Manager Library"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL (the schema is created by the migrations)
DATABASE_URL=postgresql://library:library@db:5432/library

# Stateless app: nothing is stored in the database or cache tables
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Secrets: set real values in .env (never committed)
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

COVERS_DIR=./var/covers
CORS_ORIGIN=http://localhost:5173

# Demo only (ADR-006): shifts the API clock in days. Keep 0 outside the seeding phase.
CLOCK_OFFSET_DAYS=0
